# ═══════════════════════════════════════════════════════════════
# NEXPLAY ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ═══════════════════════════════════════════════════════════════

# --- 1. SERVER CONFIGURATION ---
PORT=3005
NODE_ENV=production
FRONTEND_URL=https://www.nexplayorg.app

# --- 2. FIREBASE ADMIN & CLOUD FIRESTORE ---
# Option A (Recommended for Vercel): Single-line JSON or Base64 string of service-account.json
FIREBASE_SERVICE_ACCOUNT=
# Option B (Discrete credentials):
FIREBASE_PROJECT_ID=nexplayorg-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=nexplayorg-app.firebasestorage.app

# --- 3. GOOGLE GEMINI AI (Match Result Parsing & Banners) ---
# Get API key at https://aistudio.google.com/
GEMINI_API_KEY=

# --- 4. IMGBB (Primary Media & Proof Uploads) ---
# Get API key at https://api.imgbb.com/
IMGBB_API_KEY=

# --- 5. CLOUDINARY (Optional Secondary Media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 6. DISCORD WEBHOOKS (Optional Match Announcements) ---
DISCORD_WEBHOOK_TOURNAMENTS=
DISCORD_WEBHOOK_SCRIMS=

# --- 7. ADMIN SECURITY KEYS ---
ADMIN_BOOTSTRAP_KEY=
SEED_GAME_KEY=

# --- 8. CLIENT-SIDE VARIABLES (Vite / Public) ---
VITE_RECAPTCHA_SITE_KEY=
